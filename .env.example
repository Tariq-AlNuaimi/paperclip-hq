# Copy to .env (gitignored) and fill in.

# Upstream commit to build (https://github.com/paperclipai/paperclip/commits/master).
# Pin a full SHA; bootstrap.sh records what it built in .paperclip-ref.
PAPERCLIP_REF=master

# Tailscale IPv4 of this VM (`tailscale ip -4`). The UI is bound ONLY here, never 0.0.0.0.
BIND_ADDRESS=""
PAPERCLIP_PORT=3100

# Host directory for all state: embedded Postgres, uploads, secrets key, agent workspaces.
# Relative to upstream/docker/, so ../../data is ./data in this repo.
PAPERCLIP_DATA_DIR=../../data

# Claude Code (claude_local adapter). Create a dedicated key in a dedicated Anthropic workspace
# with a monthly spend limit: https://console.anthropic.com/settings/limits
ANTHROPIC_API_KEY=""

# GitHub fine-grained PAT for agents: only the repos you list, Contents RW + Pull requests RW,
# nothing else. See GUARDRAILS.md.
GH_TOKEN=""

# Opt out of upstream telemetry.
PAPERCLIP_TELEMETRY_DISABLED=1

# Session signing + approval-signed tool actions. Generate each ONCE with `openssl rand -hex 32`;
# never replace on restart (it logs everyone out / invalidates pending approvals).
BETTER_AUTH_SECRET=""
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=""

# URL you open the UI at, e.g. http://paperclip-vm:3100 (your Tailscale MagicDNS name).
PAPERCLIP_PUBLIC_URL=""
# Extra hostnames accepted, comma-separated (e.g. the 100.x IP if you also browse by IP).
PAPERCLIP_ALLOWED_HOSTNAMES=""
